{
  "class": "export-binary",
  "extension": ".skel",
  "format": "binary",
  "nonessential": false,
  "cleanUp": false,
  "warnings": true,
  "packAtlas": {
    "stripWhitespaceX": true,
    "stripWhitespaceY": true,
    "rotation": true,
    "alias": true,
    "ignoreBlankImages": true,
    "alphaThreshold": 3,
    "minWidth": 16,
    "minHeight": 16,
    "maxWidth": 2048,
    "maxHeight": 2048,
    "pot": false,
    "multipleOfFour": true,
    "square": false,
    "outputFormat": "png",
    "jpegQuality": 0.9,
    "premultiplyAlpha": true,
    "bleed": true,
    "scale": [1],
    "scaleSuffix": [""],
    "filterMin": "Linear",
    "filterMag": "Linear",
    "wrapX": "ClampToEdge",
    "wrapY": "ClampToEdge",
    "format": "RGBA8888",
    "atlasExtension": ".atlas"
  }
}
